/**
* Create the Drupal blocks.
*/

 /**
 * Implements hook_block_info().
*/
function telrhin_map_block_info() {
   $blocks = array();
   $blocks['telrhin_map'] = array(
     'info' => t("Telrhin Map"),
   );
   return $blocks;
}

/**
* Implements hook_block_view().
*/

function telrhin_map_block_view($delta = '') {
  $block = array();
  switch ($delta) {
    case 'telrhin_map':
      $the_block = telrhin_map_spitout();
      $block['title'] = t('Telrhin Map');
      $block['content'] = $the_block;
      break;
    }
  return $block;
}

