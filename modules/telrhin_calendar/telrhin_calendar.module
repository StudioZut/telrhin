<?php

/**
 * @file
 * Provides blocks to display the Telrhin calendar.
 */

/**
 * Implements hook_menu().
 */
function telrhin_calendar_menu() {
  $items = array();

  $items['admin/config/content/telrhin_calendar'] = array(
    'title' => 'Telrhin calendar settings',
    'description' => 'Configure the dates and text for Telrhin holidays.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('telrhin_calendar_settings_form'),
    'access arguments' => array('administer site configuration'),
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

/**
 * Holiday definitions: title, default dates and default text, by group.
 *
 * 'dates' are Telrhin dates (see _telrhin_calendar_months()): a
 * comma-separated list of days ("Parda 1"), ranges within a month
 * ("Bendel 8-14") or across months ("Kellet 28 to Melbid 2"), and/or
 * "Year's End". Both dates and text can be overridden on the settings page
 * (telrhin_calendar_KEY_dates, telrhin_calendar_KEY_text variables); these
 * are the fallbacks.
 */
function _telrhin_calendar_get_holiday_defaults() {
  return array(
    'spring' => array(
      'springtide' => array('title' => 'Springtide', 'dates' => 'Parda 1', 'default' => "<h4>Happy Springtide! And a Good Septarmas to our Rayikan friends!</h4><p>Spring 1st (Parda 1st): Enter Springtide Text Here</p>"),
      'firstfull'  => array('title' => 'First Full', 'dates' => 'Parda 21', 'default' => "<h4>Happy Fulle'en and final day of Fullwik!</h4><p>Spring 21st (Parda 21st): Enter First Full Text Here</p>"),
      'myrday'     => array('title' => 'Myr Day', 'dates' => 'Illom 21', 'default' => "<h4>Happy Myr Day and Longmondi! Long Live the Baron!</h4><p>Spring 51st (Illom 21st): a celebration in the citystate of Lark-Han and surrounding villages in honor of their current prince, Baron Zodmius. Derisively nicknamed Zodmoot by his detractors. Parades and fireworks. This is timed to coincide with Long Moon Day ('longmondi'), when Tala is waxing full for the first time of the new year.</p>"),
      'victory'    => array('title' => 'Victory Day', 'dates' => 'Sillas 31', 'default' => "<h4>Great Victory Day to our Damoran friends!</h4><p>Spring 91st (Sillas 31st): Pronounced victor-dee, a patriotic holiday in the Empire in celebration of the end of the Blackbanner wars and the founding of the kingdom in -1599n. Westron dissidents usually call it Straw Day (straw-dee), a banned term in the Empire.</p>"),
    ),
    'summer' => array(
      'blacktide'     => array('title' => 'Blacktide / Second Full', 'dates' => 'Ashlom 21', 'default' => "<h4>Merry Second Full and Happy Blacktide! And a fine Awakening Day to our Rayikan friends!</h4><p>Summer 21st (Ashlom 21st): A holy day for Talans and Lunans. Mostly a Westron holiday, it’s known as Blacktide among Southrons. Boxing, caber tossing and other feats, along with a good game of scrut. Also, Rayikans pray to Tempes on this day (the '4th Day of Awakening').</p>"),
      'seneca'        => array('title' => 'Feast of Seneca', 'dates' => 'Ashlom 24', 'default' => "<h4>Happy Feast of Seneca to our Rayikan friends!</h4><p>Summer 24th (Ashlom 24th): the '7th Day of Awakening' which is the 'Illumination' for Rayikans. Lots of singing and charity events at the temples.</p>"),
      'tarn'          => array('title' => 'Tarn', 'dates' => 'Relt 10', 'default' => "<h4>Merry Tarn! A toast to 'Good King Endrik'</h4><p>Summer 40th (Relt 10th): Zhanian day in honor of Endrik Stonebearer and March of 330n. A thanksgiving and a day of memorial to the war dead. 'To Good King Endrik!' goes the toast. In Rhask-Edaan they toast this day as Seliz Rhu-Haal Dan, the 'price of the great jewel': one of many necessary tragedies in the Boradun path towards the Great War that unmakes the World.</p>"),
      'carnutes'      => array('title' => 'Carnutes', 'dates' => 'Bendel 6-7', 'default' => "<h4>Carnutes</h4><p>Summer 66-67th (Bendel 6-7th): the key festival among the druidic cults, also celebrated by farming communities, Dremen and (oddly enough) Kerden. This is the summer solstice (Midsummer's Day). Usually celebrated in the woods with a bonfire, all night revelries and storytelling. Believed to be the time when the divide between the First and Second worlds is the weakest.</p>"),
      'bokat'         => array('title' => 'Bokat', 'dates' => 'Bendel 8-14', 'default' => "<h4>Joyous Bokat!</h4><p>Summer 68th-74th (Bendel 8-14): A Meledian and Astavian week of feasts and festivals (and weddings!).</p>"),
      'orhwik_summer' => array('title' => 'Summer Orhwik', 'dates' => 'Ashlom 18-25', 'default' => "<h4>Good Orhwik to you!</h4><p>Summer 18th to 25th (Ashlom 18-25): The Summer Concordance. This is an event that occurs twice a year when Orh hangs full in the sky for seven days. On the last day there's a feast, and people wear comical hats that look like common objects like a beehive, a chamber pot, a lantern, an anvil.</p>"),
    ),
    'autumn' => array(
      'sabbess'   => array('title' => 'Sabbess / Mehrgan', 'dates' => 'Sepper 30', 'default' => "<h4>Merry Sabbess! And Happy Mehrgan to our Boradun friends!</h4><p>Autumn 30th (Sepper 30th): A two day festival celebrating the harvest. Feasts, music, and a costume parade that often includes a procession with people in giant rat costumes getting 'marched out' of the village. The Boradun celebrate this as Mehrgan, when they open their cities to the Lowlanders hauling in their crops for sale.</p>"),
      'thirdfull' => array('title' => 'Third Full', 'dates' => 'Sepper 21', 'default' => "<h4>A safe Third Full to everyone!</h4><p>Autumn 21st (Sepper 21st): The Third Full is considered a day of bad luck by Westrons and Abantu. Stores and shops are closed. Both moons appear over the Well in the night sky (the black void between the stars).</p>"),
      'highhog'   => array('title' => 'High Hog Day', 'dates' => 'Sophor 31', 'default' => "<h4>Happy High Hog Day</h4><p>Autumn 91st (Sophor 31st): a rural celebration among Westrons in the Lowlands and Ausgourd, the dates vary and villages can have the High Hog Day Feast any time in late Autumn. There's a pig contest, a local Queen of the Hog (who mock-marries the award-winning pig), lots of dancing and drinking and pie eating.</p>"),
      'cullwik'   => array('title' => 'Cullwik (Blood Week)', 'dates' => 'Sophor 5-11', 'default' => "<h4>Happy Cullwik! (Blood Week)</h4><p>Autumn 66th-72nd (Sophor 5th-11th): The fall culling of the herds, 'flesh week' for all the prized extra meat served at meals. A time of feasts and celebration, with animal sacrifices to the gods. Often celebrated with animal masks and necklaces full of papier-mache animal parts like livers, hearts, ears, and the occasional dong.</p>"),
    ),
    'winter' => array(
      'kingtide'      => array('title' => 'Kingtide', 'dates' => 'Kellet 3', 'default' => "<h4>Merry Kingtide to our Ausgourdian friends!</h4><p>Winter 3rd (Kellet 3rd): honors the 'Great Victory of King Ausgourd' over the western River Clans. This was the battle that founded Ausgourd in 920n.</p>"),
      'warsend'       => array('title' => 'Warsend Day', 'dates' => 'Kellet 21', 'default' => "<h4>A fine Warsend Day to you, and a Blessed Quartering Day to those who celebrate it</h4><p>Winter 21st (Kellet 21st): a day of fasting, in honor of those who died in the Great War. The Rayikan Church uses this day to honor the Quartering ('Blessed Quartering Day!'), which also requires fasting.</p>"),
      'midwinter'     => array('title' => 'Midwinter\'s Day', 'dates' => 'Romstil 6', 'default' => "<h4>Happy Midwinter's Day!</h4><p>Winter 66th (Romstil 6th): a day of “dark magic when spirits roam the land”, celebrated by the Secret Circle, Varas, Seht, and others. Locals are suspicious of people who look tired and hungover the next day. Rayikians treat it as a day of mourning and close their shops.</p>"),
      'gracemas'      => array('title' => 'Gracemas', 'dates' => 'Romstil 21', 'default' => "<h4>A Happy Gracemas to our Rayikian friends!</h4><p>Winter 81st (Romstil 21st): Rayikian holiday originally a celebration in honor of Savana for the strength to make it through the winter, it’s now more or less a celebration to Tempes and Argos as well (thanks to a convoluted passage in the Rayika).</p>"),
      'iron'          => array('title' => 'Day of Iron', 'dates' => 'Romstil 31', 'default' => "<h4>A Merry Day of Iron to our Boradun friends!</h4><p>Winter 91st (Romstil 31st): a Boradun holiday in honor of Galek's banishment from Hirtor Harad. Usually celebrated in the Lowlands as a market day or fair. Also celebrated in Khitagan as Boradun Day. For the Boradun (outside of Rooksholm) it's often a week-long party of irreverence celebrating Galek 'sticking it to the gods' with bawdy songs and men wearing costume comedy breasts.</p>"),
      'orhwik_winter' => array('title' => 'Winter Orhwik', 'dates' => 'Kellet 18-25', 'default' => "<h4>Good Orhwik to you!</h4><p>Winter 18th to 25th (Kellet 18-25): The Winter Concordance. This is an event that occurs twice a year when Orh hangs full in the sky for seven days. On the last day there's a feast, and people wear comical hats made of pine cones and twigs.</p>"),
    ),
    'recurring' => array(
      'carndur' => array('title' => 'Carn Dur (Thiefbane)', 'dates' => 'Sillas 18, Bendel 18, Sophor 18, Romstil 18', 'default' => "<h4>A Good Carn Dur to everyone!</h4><p>Carn Dur (also called Thiefbane), celebrated every 78th (18th of Sillas, Bendel, Sophor and Romstil): Westron day of thanksgiving and community feasts honoring families and tradition (focus on obedience and honesty).</p>"),
    ),
  );
}

/**
 * Returns the current holidays, keyed by machine name.
 *
 * Holidays are stored in the 'telrhin_calendar_holidays' variable once the
 * settings page has been saved. Until then they come from
 * _telrhin_calendar_get_holiday_defaults() (with any per-holiday
 * telrhin_calendar_KEY_dates / _text overrides from the earlier version).
 *
 * @return array
 *   Key => array('title' => string, 'dates' => string, 'text' => string),
 *   ordered by the first date of each holiday.
 */
function _telrhin_calendar_get_holidays() {
  $holidays = variable_get('telrhin_calendar_holidays', NULL);
  if ($holidays === NULL) {
    $holidays = array();
    foreach (_telrhin_calendar_get_holiday_defaults() as $group) {
      foreach ($group as $key => $data) {
        $holidays[$key] = array(
          'title' => $data['title'],
          'dates' => variable_get('telrhin_calendar_' . $key . '_dates', $data['dates']),
          'text' => variable_get('telrhin_calendar_' . $key . '_text', $data['default']),
        );
      }
    }
  }
  uasort($holidays, '_telrhin_calendar_compare_holidays');
  return $holidays;
}

/**
 * Sort callback: by first date, then by name.
 */
function _telrhin_calendar_compare_holidays($a, $b) {
  $first_a = _telrhin_calendar_first_day($a['dates']);
  $first_b = _telrhin_calendar_first_day($b['dates']);
  if ($first_a !== $first_b) {
    return $first_a - $first_b;
  }
  return strcasecmp($a['title'], $b['title']);
}

/**
 * First day number of a dates string (Year's End sorts last; invalid first).
 */
function _telrhin_calendar_first_day($dates) {
  $ranges = _telrhin_calendar_parse_dates($dates);
  if (!$ranges) {
    return -1;
  }
  $first = $ranges[0][0];
  return $first === 0 ? 365 : $first;
}

/**
 * Settings-page tab for a holiday, worked out from its dates.
 *
 * @return string
 *   'spring', 'summer', 'autumn' or 'winter' when every day falls in one
 *   season (Year's End counts as winter), otherwise 'recurring'.
 */
function _telrhin_calendar_holiday_group($dates) {
  $ranges = _telrhin_calendar_parse_dates($dates);
  if (!$ranges) {
    return 'recurring';
  }
  $seasons = array();
  foreach (_telrhin_calendar_expand_ranges($ranges) as $n) {
    $seasons[$n === 0 ? 3 : (int) floor(($n - 1) / 91)] = TRUE;
  }
  $names = array('spring', 'summer', 'autumn', 'winter');
  return count($seasons) === 1 ? $names[key($seasons)] : 'recurring';
}

/**
 * Form builder for the Telrhin calendar settings page.
 *
 * Holidays are grouped in vertical tabs by season; each holiday is a
 * collapsed section with its name, dates, text and a delete checkbox. A
 * separate section adds a new holiday.
 */
function telrhin_calendar_settings_form($form, &$form_state) {
  $form['intro'] = array(
    '#markup' => '<p>' . t('Holiday dates are Telrhin dates. Each holiday appears in the tab for its season; holidays spanning several seasons are under Recurring.') . '</p>',
  );

  $form['holiday_tabs'] = array('#type' => 'vertical_tabs');
  $tabs = array(
    'spring' => t('Spring holidays'),
    'summer' => t('Summer holidays'),
    'autumn' => t('Autumn holidays'),
    'winter' => t('Winter holidays'),
    'recurring' => t('Recurring holidays'),
  );
  foreach ($tabs as $group => $title) {
    $form[$group] = array(
      '#type' => 'fieldset',
      '#title' => $title,
      '#group' => 'holiday_tabs',
    );
  }

  $form['holidays'] = array('#tree' => TRUE);
  $count = array_fill_keys(array_keys($tabs), 0);
  foreach (_telrhin_calendar_get_holidays() as $key => $holiday) {
    $group = _telrhin_calendar_holiday_group($holiday['dates']);
    $count[$group]++;
    $form['holidays'][$key] = array(
      '#type' => 'fieldset',
      '#title' => check_plain($holiday['title']) . ' — ' . check_plain($holiday['dates']),
      '#collapsible' => TRUE,
      '#collapsed' => TRUE,
      '#group' => $group,
    );
    $form['holidays'][$key] += _telrhin_calendar_holiday_fields($holiday);
    $form['holidays'][$key]['delete'] = array(
      '#type' => 'checkbox',
      '#title' => t('Delete this holiday'),
      '#weight' => 10,
    );
  }
  foreach ($count as $group => $n) {
    if (!$n) {
      $form[$group]['empty'] = array('#markup' => '<p>' . t('No holidays.') . '</p>');
    }
  }

  $form['new'] = array(
    '#type' => 'fieldset',
    '#title' => t('Add a holiday'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#tree' => TRUE,
  );
  $form['new'] += _telrhin_calendar_holiday_fields(array('title' => '', 'dates' => '', 'text' => ''), FALSE);
  $form['new']['key'] = array(
    '#type' => 'machine_name',
    '#title' => t('Machine name'),
    '#required' => FALSE,
    '#maxlength' => 64,
    '#machine_name' => array(
      'exists' => '_telrhin_calendar_holiday_exists',
      'source' => array('new', 'title'),
    ),
    '#weight' => 1,
  );

  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => t('Save configuration'));
  return $form;
}

/**
 * Builds the name, dates and text fields for one holiday.
 */
function _telrhin_calendar_holiday_fields(array $holiday, $required = TRUE) {
  return array(
    'title' => array(
      '#type' => 'textfield',
      '#title' => t('Name'),
      '#default_value' => $holiday['title'],
      '#required' => $required,
      '#maxlength' => 128,
      '#weight' => 0,
    ),
    'dates' => array(
      '#type' => 'textfield',
      '#title' => t('Dates'),
      '#default_value' => $holiday['dates'],
      '#description' => t('Telrhin date, e.g. Parda 1. Separate several dates with commas; give a range as Bendel 8-14 or Kellet 28 to Melbid 2. Use "Year\'s End" for the day(s) after Romstil 31. Months (days): @months.', array('@months' => _telrhin_calendar_month_list())),
      '#size' => 40,
      '#required' => $required,
      '#weight' => 2,
    ),
    'text' => array(
      '#type' => 'textarea',
      '#title' => t('Text'),
      '#default_value' => $holiday['text'],
      '#description' => t('Text to display during this holiday. HTML tags like &lt;h4&gt; and &lt;p&gt; are allowed.'),
      '#rows' => 4,
      '#weight' => 3,
    ),
  );
}

/**
 * Machine-name "exists" callback for new holidays.
 */
function _telrhin_calendar_holiday_exists($key) {
  $holidays = _telrhin_calendar_get_holidays();
  return isset($holidays[$key]);
}

/**
 * Validation handler: check and normalize holiday names and dates.
 */
function telrhin_calendar_settings_form_validate($form, &$form_state) {
  $date_error = t('use Telrhin dates like Parda 1, separated by commas, ranges like Bendel 8-14 or Kellet 28 to Melbid 2, or Year\'s End. Check the day exists in that month.');
  $days = array();

  if (!empty($form_state['values']['holidays'])) {
    foreach ($form_state['values']['holidays'] as $key => $holiday) {
      if (!empty($holiday['delete'])) {
        continue;
      }
      $ranges = _telrhin_calendar_parse_dates($holiday['dates']);
      if ($ranges === FALSE) {
        form_set_error('holidays][' . $key . '][dates', t('%holiday: !error', array('%holiday' => $holiday['title'], '!error' => $date_error)));
        continue;
      }
      // Store a tidy version ("Bendel 6-7, Bendel 18").
      form_set_value($form['holidays'][$key]['dates'], _telrhin_calendar_format_dates($ranges), $form_state);
      foreach (_telrhin_calendar_expand_ranges($ranges) as $n) {
        $days[$n][] = $holiday['title'];
      }
    }
  }

  // Adding a holiday is optional; if any part of it is filled in, require
  // a name, machine name and dates.
  $new = $form_state['values']['new'];
  if (trim($new['title']) !== '' || trim($new['dates']) !== '' || trim($new['text']) !== '') {
    if (trim($new['title']) === '') {
      form_set_error('new][title', t('Give the new holiday a name.'));
    }
    if ($new['key'] === '') {
      form_set_error('new][key', t('Give the new holiday a machine name.'));
    }
    $ranges = _telrhin_calendar_parse_dates($new['dates']);
    if ($ranges === FALSE) {
      form_set_error('new][dates', t('New holiday: !error', array('!error' => $date_error)));
    }
    else {
      form_set_value($form['new']['dates'], _telrhin_calendar_format_dates($ranges), $form_state);
      foreach (_telrhin_calendar_expand_ranges($ranges) as $n) {
        $days[$n][] = $new['title'];
      }
    }
  }

  // Overlaps are allowed (single dates win over ranges), but point them out.
  $overlaps = array();
  ksort($days);
  foreach ($days as $n => $titles) {
    if (count($titles) > 1) {
      $overlaps[] = _telrhin_calendar_day_label($n) . ' (' . implode(', ', $titles) . ')';
    }
  }
  if ($overlaps && !form_get_errors()) {
    drupal_set_message(t('These days have more than one holiday: @list. Only one is shown: a single-day date wins over a range, otherwise the one with the earlier first date.', array('@list' => implode('; ', $overlaps))), 'warning');
  }
}

/**
 * Submit handler: save all holidays, including additions and deletions.
 */
function telrhin_calendar_settings_form_submit($form, &$form_state) {
  $holidays = array();
  $deleted = array();
  if (!empty($form_state['values']['holidays'])) {
    foreach ($form_state['values']['holidays'] as $key => $holiday) {
      if (!empty($holiday['delete'])) {
        $deleted[] = $holiday['title'];
        continue;
      }
      $holidays[$key] = array(
        'title' => trim($holiday['title']),
        'dates' => $holiday['dates'],
        'text' => $holiday['text'],
      );
    }
  }

  $new = $form_state['values']['new'];
  if ($new['key'] !== '' && trim($new['title']) !== '') {
    $holidays[$new['key']] = array(
      'title' => trim($new['title']),
      'dates' => $new['dates'],
      'text' => $new['text'],
    );
    drupal_set_message(t('Added %holiday.', array('%holiday' => trim($new['title']))));
  }

  variable_set('telrhin_calendar_holidays', $holidays);

  // The per-holiday variables of the earlier version are now folded into
  // telrhin_calendar_holidays; remove them so they can't come back.
  db_delete('variable')
    ->condition('name', db_like('telrhin_calendar_') . '%' . db_like('_dates'), 'LIKE')
    ->execute();
  db_delete('variable')
    ->condition('name', db_like('telrhin_calendar_') . '%' . db_like('_text'), 'LIKE')
    ->execute();
  cache_clear_all('variables', 'cache_bootstrap');

  if ($deleted) {
    drupal_set_message(t('Deleted: %list.', array('%list' => implode(', ', $deleted))));
  }
  drupal_set_message(t('The configuration options have been saved.'));

  // Anonymous page cache would otherwise keep the old holiday for up to an hour.
  cache_clear_all();
}

/**
 * The Telrhin (Dacarthite) months in order, with their lengths.
 *
 * Each season is 30 + 30 + 31 = 91 days; the year is exactly 364 days with
 * no leap years. Parda 1 (Spring 1, New Year) is real-world March 1.
 */
function _telrhin_calendar_months() {
  return array(
    'Parda' => 30, 'Illom' => 30, 'Sillas' => 31,
    'Ashlom' => 30, 'Relt' => 30, 'Bendel' => 31,
    'Sepper' => 30, 'Bas' => 30, 'Sophor' => 31,
    'Kellet' => 30, 'Melbid' => 30, 'Romstil' => 31,
  );
}

/**
 * Month names with lengths, for help text ("Parda 30, Illom 30, ...").
 */
function _telrhin_calendar_month_list() {
  $parts = array();
  foreach (_telrhin_calendar_months() as $name => $length) {
    $parts[] = $name . ' ' . $length;
  }
  return implode(', ', $parts);
}

/**
 * Converts a Telrhin month and day to the day of the year (1-364).
 *
 * @return int|false
 *   The day number, or FALSE if the month or day is invalid.
 */
function _telrhin_calendar_day_number($month, $day) {
  $n = 0;
  foreach (_telrhin_calendar_months() as $name => $length) {
    if (strcasecmp($name, $month) === 0) {
      return ($day >= 1 && $day <= $length) ? $n + $day : FALSE;
    }
    $n += $length;
  }
  return FALSE;
}

/**
 * Splits a day of the year (1-364) into month and day.
 *
 * @return array
 *   array(month name, day of month).
 */
function _telrhin_calendar_month_day($n) {
  foreach (_telrhin_calendar_months() as $name => $length) {
    if ($n <= $length) {
      return array($name, $n);
    }
    $n -= $length;
  }
  return array('', 0);
}

/**
 * Label for a day of the year: "Bendel 8", or "Year's End" for 0.
 */
function _telrhin_calendar_day_label($n) {
  if ($n == 0) {
    return "Year's End";
  }
  list($month, $day) = _telrhin_calendar_month_day($n);
  return $month . ' ' . $day;
}

/**
 * Parses a dates string into ranges of day numbers.
 *
 * Accepts, comma-separated: "Parda 1", "Bendel 8-14", "Kellet 28 to
 * Melbid 2" (may wrap past Romstil 31) and "Year's End".
 *
 * @return array|false
 *   List of array(start, end) day numbers (1-364; 0 = Year's End; start ==
 *   end for a single day), or FALSE if anything doesn't parse.
 */
function _telrhin_calendar_parse_dates($value) {
  $ranges = array();
  foreach (preg_split('/\s*,\s*/', trim($value), -1, PREG_SPLIT_NO_EMPTY) as $part) {
    if (preg_match("/^year'?s\s+end$/i", $part)) {
      $ranges[] = array(0, 0);
      continue;
    }
    if (preg_match('/^([a-z]+)\s+(\d{1,2})(?:\s*-\s*(\d{1,2})|\s+to\s+([a-z]+)\s+(\d{1,2}))?$/i', $part, $m)) {
      $start = _telrhin_calendar_day_number($m[1], (int) $m[2]);
      if (!empty($m[3])) {
        $end = _telrhin_calendar_day_number($m[1], (int) $m[3]);
        // "Bendel 14-8" is not a range.
        if ($end !== FALSE && $end < $start) {
          return FALSE;
        }
      }
      elseif (!empty($m[4])) {
        $end = _telrhin_calendar_day_number($m[4], (int) $m[5]);
      }
      else {
        $end = $start;
      }
      if ($start === FALSE || $end === FALSE) {
        return FALSE;
      }
      $ranges[] = array($start, $end);
      continue;
    }
    return FALSE;
  }
  return $ranges ? $ranges : FALSE;
}

/**
 * Formats parsed ranges back into the settings-page notation.
 */
function _telrhin_calendar_format_dates(array $ranges) {
  $parts = array();
  foreach ($ranges as $range) {
    list($start, $end) = $range;
    if ($start === $end) {
      $parts[] = _telrhin_calendar_day_label($start);
      continue;
    }
    list($m1, $d1) = _telrhin_calendar_month_day($start);
    list($m2, $d2) = _telrhin_calendar_month_day($end);
    $parts[] = ($m1 === $m2 && $start < $end) ? "$m1 $d1-$d2" : "$m1 $d1 to $m2 $d2";
  }
  return implode(', ', $parts);
}

/**
 * Lists every day number covered by the ranges (a range may wrap the year).
 */
function _telrhin_calendar_expand_ranges(array $ranges) {
  $days = array();
  foreach ($ranges as $range) {
    list($start, $end) = $range;
    if ($start === 0) {
      $days[] = 0;
      continue;
    }
    for ($n = $start; ; $n = ($n % 364) + 1) {
      $days[] = $n;
      if ($n === $end) {
        break;
      }
    }
  }
  return $days;
}

/**
 * Returns the holiday text for a Telrhin day number, or '' if none.
 *
 * Single-day dates win over ranges; within each, the holiday with the
 * earlier first date (then name) wins.
 *
 * @param int $n
 *   Day of the Telrhin year (1-364), or 0 for Year's End.
 */
function _telrhin_calendar_holiday_for_day($n) {
  $single = $range = NULL;
  $holidays = _telrhin_calendar_get_holidays();
  foreach ($holidays as $key => $holiday) {
    $ranges = _telrhin_calendar_parse_dates($holiday['dates']);
    if (!$ranges) {
      continue;
    }
    foreach ($ranges as $r) {
      if (!in_array($n, _telrhin_calendar_expand_ranges(array($r)), TRUE)) {
        continue;
      }
      if ($r[0] === $r[1]) {
        if ($single === NULL) {
          $single = $key;
        }
      }
      elseif ($range === NULL) {
        $range = $key;
      }
    }
  }
  $key = ($single !== NULL) ? $single : $range;
  // Admin-entered HTML: allow the usual tags, strip scripts and handlers.
  return ($key === NULL) ? '' : filter_xss_admin($holidays[$key]['text']);
}

/**
 * Converts a real-world date to the Telrhin date.
 *
 * Parda 1 is March 1 every year and the Telrhin year is 364 days, so Romstil
 * 31 is February 27; February 28 (and February 29 in leap years) is
 * "Year's End", outside any month or season.
 *
 * @param string $ymd
 *   Real date as Y-m-d; defaults to today.
 *
 * @return array
 *   'day' (1-364, 0 for Year's End), 'season', 'season_day', 'month',
 *   'month_day', and 'label' (e.g. "Autumn 75 (Sophor 15)").
 */
function _telrhin_calendar_date($ymd = NULL) {
  $today = new DateTime($ymd === NULL ? date('Y-m-d') : $ymd);
  $year = (int) $today->format('Y');
  if ((int) $today->format('n') < 3) {
    $year--;
  }
  $start = new DateTime($year . '-03-01');
  $n = $start->diff($today)->days + 1;

  if ($n > 364) {
    return array('day' => 0, 'season' => '', 'season_day' => 0, 'month' => '', 'month_day' => 0, 'label' => "Year's End");
  }
  $seasons = array('Spring', 'Summer', 'Autumn', 'Winter');
  $season = $seasons[(int) floor(($n - 1) / 91)];
  $season_day = (($n - 1) % 91) + 1;
  list($month, $month_day) = _telrhin_calendar_month_day($n);
  return array(
    'day' => $n,
    'season' => $season,
    'season_day' => $season_day,
    'month' => $month,
    'month_day' => $month_day,
    'label' => "$season $season_day ($month $month_day)",
  );
}

/**
 * Implements hook_block_info().
 */
function telrhin_calendar_block_info() {
  $blocks = array();
  $blocks['telrhin_calendar_today_verbose'] = array(
    'info' => t("Telrhin Today for Home Page (public)"),
    'cache' => DRUPAL_CACHE_PER_PAGE,
  );
  $blocks['telrhin_calendar_today_sidebar'] = array(
    'info' => t("Telrhin Today Sidebar for Calendar Page (auth user)"),
    'cache' => DRUPAL_CACHE_PER_ROLE,
  );
  return $blocks;
}

/**
 * Implements hook_block_view().
 */
function telrhin_calendar_block_view($delta = '') {
  $block = array();
  
  if ($delta == 'telrhin_calendar_today_verbose' || $delta == 'telrhin_calendar_today_sidebar') {
    $cal_data = _telrhin_calendar_get_data();
    
    switch ($delta) {
      case 'telrhin_calendar_today_verbose':
        $block['title'] = t('Today in Telrhin');
        $block['content'] = "<div class='holiday-string-verb'>" . $cal_data['holiday'] . "</div>" .
                            "<blockquote><div class='weekday-string-verb'>" . $cal_data['weekday'] . "</div>" .
                            "<div class='today-string-verb'>Today's date in Telrhin is " . $cal_data['date'] . "</div></blockquote>";
        break;
        
      case 'telrhin_calendar_today_sidebar':
        $block['title'] = t('Telrhin Today');
        $block['content'] = "<div class='holiday-string-side'>" . $cal_data['holiday'] . "</div>" .
                            "<div class='weekday-string-side'>" . $cal_data['weekday'] . "</div>" .
                            "<blockquote><div class='today-string-side'>Today's date in Telrhin is " . $cal_data['date'] . "</div></blockquote>" . 
                            $cal_data['auth_link'];
        break;
    }
  }
  return $block;
}

/**
 * Helper function to calculate calendar strings dynamically.
 */
function _telrhin_calendar_get_data() {
  // --- 1. SET WEEKDAY STRING ---
  $day_map = array(
    'Monday'    => array('Luins, the first day of the week', 'Lors'),
    'Tuesday'   => array('Bahrs, the second day of the week', 'Crons'),
    'Wednesday' => array('Sein, the third day of the week', 'Savans'),
    'Thursday'  => array('Tor, the fourth day of the week', 'Tims'),
    'Friday'    => array('Bode, the fifth day of the week', 'Rone'),
    'Saturday'  => array('Wahrs, the sixth day of the week', 'Vath'),
    'Sunday'    => array('Taelens, the seventh day of the week', 'Tale'),
  );
  
  $current_day = date("l");
  $telcal = isset($day_map[$current_day][0]) ? $day_map[$current_day][0] : '';
  $telcal2 = isset($day_map[$current_day][1]) ? $day_map[$current_day][1] : '';
  $weekday_string = "Today is " . $telcal . " in the Lowlands. In the Empire they call it <em>" . $telcal2 . "</em> (Rayikian calendar).";

  // --- 2. SET TELRHIN DATE (Parda 1 = March 1; see _telrhin_calendar_date()) ---
  $telrhin_date = _telrhin_calendar_date();
  $date_string = $telrhin_date['label'];

  // --- 3. SET HOLIDAY STRING ---
  // Dates and text come from the settings page (or the defaults).
  $holString = _telrhin_calendar_holiday_for_day($telrhin_date['day']);

  // --- 4. SET AUTH USER LINK ---
  global $user;
  $auth_link = '';
  if ($user->uid) {
    $auth_link = "<p>[<a href='/world/calendar' title='click here for more information on holidays, moon phases and the Telrhin calendar'>calendar, moon phases and holidays</a>]</p>";
  }

  return array(
    'weekday'   => $weekday_string,
    'date'      => $date_string,
    'holiday'   => $holString,
    'auth_link' => $auth_link,
  );
}
